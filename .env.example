# The public shell does not require database settings.
# Required only when server database access is requested; use .env.local or a
# deployment secret manager. Integration fixtures never read these values.
MONGODB_URI=
MONGODB_DB_NAME=
# Production connections require verified TLS. See docs/DEVELOPMENT.md.
# Never put secrets in variables prefixed with NEXT_PUBLIC_.

# Optional local-development Gmail SMTP adapter (not recovery route activation).
# Use a dedicated Google app password, never your normal Google password.
GMAIL_USER=
GMAIL_SENDER_NAME=LibraryOS
GMAIL_APP_PASSWORD=

# Reviewed local UTF-8 password blocklist; no fallback or network lookup.
AUTH_PASSWORD_BLOCKLIST_PATH=
AUTH_PASSWORD_BLOCKLIST_SHA256=
AUTH_PASSWORD_BLOCKLIST_SOURCE=
