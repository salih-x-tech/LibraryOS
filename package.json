{
  "name": "libraryos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "dev:https": "node --conditions=react-server scripts/dev-https.ts",
    "auth:local:setup": "node scripts/setup-local-auth.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:auth:browser": "npm run test:db:prepare && vitest run --config vitest.auth-browser.config.ts",
    "test:integration": "npm run test:db:prepare && vitest run --config vitest.integration.config.ts",
    "test:db:prepare": "node tests/integration/helpers/prepare-mongodb.ts",
    "db:auth:plan": "node --conditions=react-server scripts/db/deploy-auth.ts --plan",
    "db:auth:verify": "node --conditions=react-server --env-file=.env.local scripts/db/deploy-auth.ts --verify",
    "db:auth:apply": "node --conditions=react-server --env-file=.env.local scripts/db/deploy-auth.ts --apply",
    "db:plan": "node --conditions=react-server scripts/db/deploy.ts --plan",
    "db:verify": "node --conditions=react-server --env-file=.env.local scripts/db/deploy.ts --verify",
    "db:apply": "node --conditions=react-server --env-file=.env.local scripts/db/deploy.ts --apply",
    "benchmark:passwords": "node --conditions=react-server scripts/benchmark-passwords.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "mongoose": "9.11.2",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server-core": "11.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
